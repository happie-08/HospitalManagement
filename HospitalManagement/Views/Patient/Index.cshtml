@{
    ViewData["Title"] = "Patient List";
    Layout = "~/Views/Shared/_NavbarLayout.cshtml";
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="content" style="height: calc(100vh - 100px); overflow-y: auto;">
    <div class="page-inner">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <!-- Left Side: Title + Breadcrumb -->
            <div class="d-flex align-items-center gap-3">
                <h4 class="mb-0 page-title">Patient List</h4>
                <ul class="breadcrumbs mb-0 d-flex align-items-center">
                    <li class="nav-home">
                        <a asp-controller="Dashboard" asp-action="Index">
                            <i class="fas fa-home"></i>
                        </a>
                    </li>
                    <li class="separator"><i class="fas fa-chevron-right"></i></li>
                    <li class="nav-item"><a href="#">Patient List</a></li>
                </ul>
            </div>

            <!-- Right Side: Add Button -->
            <a href="/Patient/Create" class="btn btn-success btn-sm">
                <i class="fas fa-plus"></i> Add Patient
            </a>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="patientTable" class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Profile / Name</th>
                                        <th>Gender / Contact</th>
                                        <th>DOB / Email</th>
                                        <th>Height (cm)</th>
                                        <th>Weight (kg)</th>
                                        <th>Address</th>
                                        <th>Reference Doctor</th>
                                        <th>Remark</th>
                                        <th style="width: 180px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            $('#patientTable').DataTable({
            ajax: {
            url: '@Url.Action("GetAll", "Patient")',
            dataSrc: 'data'
                },
                columns: [
                    { data: null, render: (data,type,row,meta) => meta.row + 1 },
                    {
                        data: null,
                        render: data => {
                            const imgSrc = data.image ? `/uploads/${data.image}` : '/uploads/user.png';
                            return `<div class="d-flex align-items-center">
                                        <img src="${imgSrc}" class="img-circle me-2" style="width:40px;height:40px;object-fit:cover;">
                                        <span>${data.firstName ?? ''} ${data.lastName ?? ''}</span>
                                    </div>`;
                        }
                    },               

                    { // Gender + Contact
                        data: null,
                        render: d => `${d.gender ?? '-'}<br/><small>${d.contactNo ?? '-'}</small>`
                    },
                    { // DOB + Email
                        data: null,
                        render: function (d) {
                            const dob = d.dateOfBirth
                                ? new Date(d.dateOfBirth).toLocaleDateString('en-GB')
                                : '-';
                            return `${dob}<br/><small>${d.email ?? '-'}</small>`;
                        }
                    },
                    { data: 'height', render: d => d ? d + ' cm' : '-' },
                    { data: 'weight', render: d => d ? d + ' kg' : '-' },
                    { data: 'address', defaultContent: '-' },
                    { // Reference Doctor
                        data: 'referenceDoctor',
                        render: d => d || '-'
                    },
                    { data: 'remark', defaultContent: '-' },
                    { // Actions
                        data: 'patientId',
                        render: function (id, type, row) {
                            return `
                                <a href="/Patient/Details/${id}" class="btn btn-secondary btn-sm">
                                    <i class="fas fa-eye"></i> Details
                                </a>
                                <a href="/Patient/Edit/${id}" class="btn btn-info btn-sm">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <button type="button" class="btn btn-danger btn-sm" onclick="deletePatient(${id}, '${row.firstName} ${row.lastName}')">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                            `;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                responsive: true,
                pageLength: 10,
                dom: '<"row align-items-center mb-3"' +
                        '<"col-md-6 d-flex align-items-center"l>' +
                        '<"col-md-6 d-flex justify-content-end align-items-center"fB>' +
                     '>rtip',
                buttons: [
                    { extend: 'excel', title: 'Patients' },
                    { extend: 'pdf', title: 'Patients' },
                ],
                language: {
                    loadingRecords: '<div class="spinner-border text-primary" role="status"></div>',
                    emptyTable: 'No patients found.'
                }
            });
        });

        function deletePatient(id, name) {
            Swal.fire({
                title: `Delete ${name}?`,
                text: "This action cannot be undone!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/Patient/Delete',
                        type: 'POST',
                        data: {
                            id: id,
                            __RequestVerificationToken: token
                        },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Deleted!', res.message, 'success');
                                $('#patientTable').DataTable().ajax.reload(null, false);
                            } else {
                                Swal.fire('Error!', res.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'Error deleting patient!', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
