@model HospitalManagement.ViewModels.OPDInvoiceViewModel
@{
    ViewData["Title"] = "Invoice";
    Layout = "~/Views/Shared/_NavbarLayout.cshtml";
}

<div class="content" style="height: calc(100vh - 100px); overflow-y: auto;">
    <div class="page-inner">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-3">
                <h4 class="mb-0 page-title">Invoice</h4>
                <ul class="breadcrumbs mb-0 d-flex align-items-center">
                    <li class="nav-home">
                        <a asp-controller="Dashboard" asp-action="Index">
                            <i class="fas fa-home"></i>
                        </a>
                    </li>
                    <li class="separator mx-2"><i class="fas fa-chevron-right"></i></li>
                    <li class="nav-item"><a asp-controller="OPD" asp-action="Index">OPD List</a></li>
                    <li class="separator mx-2"><i class="fas fa-chevron-right"></i></li>
                    <li class="nav-item"><a href="#">Invoice</a></li>
                </ul>
            </div>
            <a href="/OPD" class="btn btn-secondary btn-sm no-print">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>

        <!-- Invoice Card -->
        <div class="card">
            <div class="card-header text-center">
                <h3 class="mb-0">Novena Hospital</h3>
                <p class="mb-0">
                    Address: Ta-134/A, Surat, INDIA <br />
                    Phone: +91-98765-43210 | Email: support@novena.com
                </p>
            </div>

            <div class="card-body" id="invoiceArea">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <p><strong>Invoice No:</strong> @Model.InvoiceNumber</p>
                        <p><strong>Date:</strong> @Model.PaymentDate.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-6 text-end">
                        <p><strong>Patient Name:</strong> @Model.PatientName</p>
                        <p><strong>Doctor:</strong> @Model.DoctorName</p>
                    </div>
                </div>

                <div class="mb-3">
                    <p><strong>Diagnosis:</strong> @Model.DiagnosisName</p>
                    <p><strong>Symptoms:</strong> @Model.SymptomName</p>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="bg-light">
                            <tr>
                                <th>Description</th>
                                <th class="text-end">Amount (₹)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>OPD Charges</td>
                                <td class="text-end">@Model.Amount.ToString("0.00")</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th class="text-end">Total:</th>
                                <th class="text-end">@Model.Amount.ToString("0.00")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="card-footer text-center no-print">
                <button onclick="printInvoice()" class="btn btn-primary">
                    <i class="fas fa-print"></i> Print Invoice
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <!-- Print CSS -->
    <link rel="stylesheet" href="~/Admin/css/print.css" media="print" />
}

@section Scripts {
    <script>
        function printInvoice() {
            var printContents = document.querySelector('.card').innerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
            location.reload();
        }

    </script>
}
